# Mailtrap SMTP — copy to .env and fill in your credentials
# Get values from: Mailtrap → Email Testing → Inboxes → SMTP Settings

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Buildly Platform <noreply@buildly.local>

# Alternative variable names (also supported):
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=your_mailtrap_username
# EMAIL_HOST_PASSWORD=your_mailtrap_password

# Ollama — used by the AI Learning Assistant / Improve Code
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=120

# Placement AI (Google Gemini) — optional; without it the static question bank is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PLACEMENT_AI_ENABLED=true
